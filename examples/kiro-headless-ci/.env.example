# Example environment variables for running the examples LOCALLY.
# Copy this to `.env` (which is in .gitignore) and fill it in. NEVER commit real values.
#
# In CI/CD, do NOT use this file: store secrets as your provider's secrets
# (GitHub Actions secrets, masked/protected GitLab CI/CD variables).

# --- Kiro authentication (required) -----------------------------------------
# Kiro API key, format ksk_...  Generate one at https://app.kiro.dev
# Requires a Kiro Pro/Pro+/Pro Max/Power plan (if the account is admin-managed,
# the admin must enable API key generation).
KIRO_API_KEY=ksk_replace_with_your_key

# --- PR / pipeline review (optional) ----------------------------------------
# Base ref for the diff (default: origin/main). E.g.: origin/main, origin/develop.
BASE_REF=origin/main

# --- DAST (dast-triage mode; optional) --------------------------------------
# DAST is "bring your own scanner" (BYO): you run ZAP/Nuclei against an AUTHORIZED target,
# generate a JSON report, and the image only performs the AI TRIAGE of it (dast-triage mode).
# TARGET_URL is used by YOUR scanner (not by the image). NEVER point it at third parties.
TARGET_URL=http://localhost:8080
# Path to the DAST report to triage (an alternative to passing it via stdin):
DAST_REPORT=dast-report.json

# --- Output/logs ------------------------------------------------------------
# Logs without color/ANSI, better for CI artifacts.
KIRO_LOG_NO_COLOR=1
