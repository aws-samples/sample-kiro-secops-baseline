        <mxCell id="8" value="kiro-secops install&#xa;[--profile baseline|strict]&#xa;[--force] [--dry-run]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="7">
          <mxGeometry x="10" y="86" width="250" height="64" as="geometry" />
        </mxCell>
        <mxCell id="9" value="kiro-secops init&#xa;[--project DIR]&#xa;[--force] [--dry-run]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="7">
          <mxGeometry x="10" y="304" width="250" height="64" as="geometry" />
        </mxCell>
        <mxCell id="10" value="~/.kiro/  —  GLOBAL layer (per user, follows the person)&#xa;&#xa;• steering/ — security-policies.md (always) + 2 fileMatch files&#xa;• skills/kiro-secops-review/ — SKILL.md + 9 reference files&#xa;• agents/kiro-secops-reviewer.md — read-only reviewer&#xa;• settings/permissions.yaml — structural YAML merge (yaml.v3)&#xa;• settings/kiroignore — managed-block merge&#xa;• bin/kiro-secops — copySelf; the path the hooks pin&#xa;• settings/.kiro-secops/manifest.json + backups/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="75" width="390" height="190" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;project&gt;/  —  WORKSPACE layer (committed, follows the repo)&#xa;&#xa;• .kiro/hooks/kiro-secops.json — 6 hooks, guard path pinned&#xa;• .pre-commit-config.yaml — gitleaks · semgrep · checkov · trivy&#xa;• .gitleaks.toml · trivy.yaml · .checkov.yaml&#xa;• .github/workflows/security-scan.yml — blocking CI gate&#xa;• .kiro/kiro-secops/manifest.json + backups/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="311" width="390" height="190" as="geometry" />
        </mxCell>
        <mxCell id="12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="8">
