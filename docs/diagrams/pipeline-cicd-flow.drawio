<mxfile host="Electron" agent="Kiro">
  <diagram id="pipeline-cicd-flow" name="CI/CD security layers">
    <mxGraphModel dx="1181" dy="832" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" value="CI/CD security — deterministic hard gate vs AI advisory review" vertex="1">
          <mxGeometry height="28" width="1090" x="40" y="16" as="geometry" />
        </mxCell>
        <mxCell id="3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" value="Developer commit" vertex="1">
          <mxGeometry height="44" width="230" x="40" y="110" as="geometry" />
        </mxCell>
        <mxCell id="4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="pre-commit — local, shift-left&#xa;.pre-commit-config.yaml&#xa;gitleaks · detect-private-key · semgrep&#xa;checkov · trivy fs · hygiene hooks&#xa;--no-verify bypasses it, so CI repeats&#xa;every check" vertex="1">
          <mxGeometry height="112" width="230" x="40" y="178" as="geometry" />
        </mxCell>
        <mxCell id="5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" value="Pull request / push to main" vertex="1">
          <mxGeometry height="44" width="230" x="40" y="316" as="geometry" />
        </mxCell>
        <mxCell id="6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="kiro-secops scan — exit codes&#xa;0  no findings&#xa;1  findings (suppressed by --advisory)&#xa;2  operational failure: a scanner timed out,&#xa;    or a required scanner is missing when&#xa;    --require-tools is set&#xa;&#xa;report: --format text | json | sarif&#xa;--output FILE for SARIF upload to code&#xa;scanning. Raw scanner output is printed&#xa;only on the interactive console and never&#xa;serialized to JSON, SARIF or a file — so a&#xa;secret echoed by a scanner is not persisted&#xa;into a build artifact." vertex="1">
          <mxGeometry height="252" width="230" x="40" y="400" as="geometry" />
        </mxCell>
        <mxCell id="7" parent="1" style="swimlane;startSize=32;html=1;whiteSpace=wrap;fontStyle=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#82B366;align=center;verticalAlign=middle;collapsible=0;" value="Deterministic layer — HARD gate: reproducible, no AI, blocks the merge" vertex="1">
          <mxGeometry height="272" width="830" x="300" y="110" as="geometry" />
        </mxCell>
        <mxCell id="8" parent="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="kiro-secops scan .&#xa;semgrep (p/ci) · trivy fs (vuln, secret,&#xa;misconfig — HIGH and CRITICAL) ·&#xa;gitleaks (--no-git --redact)&#xa;by language: bandit · pip-audit ·&#xa;njsscan · npm audit · shellcheck" vertex="1">
          <mxGeometry height="102" width="240" x="24" y="48" as="geometry" />
        </mxCell>
        <mxCell id="9" parent="7" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" value="findings or operational failure?" vertex="1">
          <mxGeometry height="76" width="190" x="300" y="52" as="geometry" />
        </mxCell>
        <mxCell id="10" parent="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" value="BLOCK the merge&#xa;exit 1 = findings · exit 2 = operational failure" vertex="1">
          <mxGeometry height="48" width="280" x="526" y="40" as="geometry" />
        </mxCell>
        <mxCell id="11" parent="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" value="PASS — exit 0, merge allowed" vertex="1">
          <mxGeometry height="48" width="280" x="526" y="104" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="security-scan.yml — the blocking CI gate that &#39;kiro-secops init&#39; installs&#xa;jobs: secret-scan (gitleaks over the full history) · sast (semgrep p/owasp-top-ten + p/secrets, --error) · sca-iac (trivy exit-code 1 + checkov soft_fail: false) · sbom (trivy SPDX-JSON, uploaded as an artifact)&#xa;workflow hardening: permissions contents: read · persist-credentials: false · every action pinned by commit SHA (A08, supply chain), kept current by Dependabot" vertex="1">
          <mxGeometry height="88" width="782" x="24" y="170" as="geometry" />
        </mxCell>
        <mxCell id="23" edge="1" parent="7" source="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="24" edge="1" parent="7" source="9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="10" value="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="25" edge="1" parent="7" source="9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#82B366;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="11" value="no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13" parent="1" style="swimlane;startSize=32;html=1;whiteSpace=wrap;fontStyle=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#9673A6;align=center;verticalAlign=middle;collapsible=0;" value="AI-assisted layer — ADVISORY: non-deterministic, never blocks the merge" vertex="1">
          <mxGeometry height="272" width="830" x="300" y="422" as="geometry" />
        </mxCell>
        <mxCell id="14" parent="13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" value="git diff origin/BASE...HEAD |&#xa;kiro-cli chat --no-interactive&#xa;  --agent kiro-secops-reviewer&#xa;  --trust-tools=fs_read&#xa;  --wrap never&#xa;read-only agent: no write, no network" vertex="1">
          <mxGeometry height="102" width="240" x="24" y="48" as="geometry" />
        </mxCell>
        <mxCell id="15" parent="13" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" value="output contains VERDICT: BLOCK?" vertex="1">
          <mxGeometry height="76" width="190" x="300" y="52" as="geometry" />
        </mxCell>
        <mxCell id="16" parent="13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" value="PR comment / ::warning::&#xa;soft signal for the human reviewer" vertex="1">
          <mxGeometry height="48" width="280" x="526" y="40" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;" value="no comment — review kept in the job log" vertex="1">
          <mxGeometry height="48" width="280" x="526" y="104" as="geometry" />
        </mxCell>
        <mxCell id="18" parent="13" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" value="continue-on-error (GitHub) / allow_failure: true (GitLab) — the job reports, it never fails the pipeline&#xa;KIRO_API_KEY as a masked secret · KIRO_LOG_NO_COLOR=1 · kiro-cli exit codes: 0 ok, 1 failure, 3 MCP startup failure&#xa;slash commands do not work headless, so the skill is reached through the agent, which already carries steering + skill + read-only tools&#xa;there is no structured output format for the chat response, so the gate is a textual marker — a heuristic signal, not a verdict" vertex="1">
          <mxGeometry height="88" width="782" x="24" y="170" as="geometry" />
        </mxCell>
        <mxCell id="26" edge="1" parent="13" source="14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="27" edge="1" parent="13" source="15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="16" value="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="28" edge="1" parent="13" source="15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#82B366;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="17" value="no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="19" edge="1" parent="1" source="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="20" edge="1" parent="1" source="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="21" edge="1" parent="1" source="5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#82B366;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.331;entryDx=0;entryDy=0;" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="22" edge="1" parent="1" source="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#9673A6;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="13" value="needs: scan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="29" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fontSize=11;" value="Golden rule: the gate that blocks a merge must be deterministic. AI review is strong on logic, design and context, but it is non-deterministic, consumes credits and returns no structured output — so it runs with continue-on-error / allow_failure and is consumed as a comment or a soft signal, never as the only barrier.&#xa;The same two layers also review the pipelines themselves: deterministically with checkov and trivy config over .github/workflows and IaC; with AI by asking the reviewer about excessive GITHUB_TOKEN permissions, secrets reaching the logs, script injection through ${{ github.event.* }}, actions not pinned by SHA, and insecure pull_request_target. Do not rely on pre-commit alone — --no-verify bypasses it, so every check is repeated in CI and, for secrets, server-side through push protection." vertex="1">
          <mxGeometry height="90" width="1090" x="40" y="716" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
