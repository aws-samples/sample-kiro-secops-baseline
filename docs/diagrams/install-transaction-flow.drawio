<mxfile host="app.diagrams.net" agent="Kiro">
  <diagram id="install-transaction-flow" name="Install transaction">
    <mxGraphModel dx="1434" dy="759" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="890" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="kiro-secops install — transactional deploy (commit / rollback + SHA-256 manifest)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1090" height="28" as="geometry" />
        </mxCell>
        <mxCell id="3" value="kiro-secops install  [--profile baseline|strict]  [--force]  [--dry-run]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="62" width="360" height="48" as="geometry" />
        </mxCell>
        <mxCell id="4" value="running as root?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="130" width="300" height="58" as="geometry" />
        </mxCell>
        <mxCell id="5" value="resolveProfile(baseline | strict)&#xa;kiroHome() — KIRO_HOME must be absolute, default ~/.kiro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="208" width="360" height="48" as="geometry" />
        </mxCell>
        <mxCell id="6" value="openSafeRoot(home) — os.OpenRoot&#xa;root confinement + symlink refused in every component" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="276" width="360" height="48" as="geometry" />
        </mxCell>
        <mxCell id="7" value="beginManagedTransaction&#xa;scope=global · txid = 8 random bytes" style="swimlane;startSize=44;html=1;whiteSpace=wrap;fontStyle=1;fontSize=12;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;verticalAlign=middle;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="344" width="360" height="274" as="geometry" />
        </mxCell>
        <mxCell id="8" value="extractTree → steering/ · skills/ · agents/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="7">
          <mxGeometry x="14" y="54" width="332" height="44" as="geometry" />
        </mxCell>
        <mxCell id="9" value="mergePermissionsData → settings/permissions.yaml&#xa;structural YAML merge (yaml.v3), managed rules re-tagged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="7">
          <mxGeometry x="14" y="108" width="332" height="44" as="geometry" />
        </mxCell>
        <mxCell id="10" value="mergeKiroignoreData → settings/kiroignore&#xa;only the managed block is replaced" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="7">
          <mxGeometry x="14" y="162" width="332" height="44" as="geometry" />
        </mxCell>
        <mxCell id="11" value="copySelf → bin/kiro-secops (mode 0755)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="7">
          <mxGeometry x="14" y="216" width="332" height="44" as="geometry" />
        </mxCell>
        <mxCell id="12" value="every step succeeded?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="638" width="300" height="58" as="geometry" />
        </mxCell>
        <mxCell id="13" value="tx.Commit() — atomic write of manifest.json (0600)&#xa;the transaction is sealed: uninstall and verify --strict become possible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="716" width="360" height="56" as="geometry" />
        </mxCell>
        <mxCell id="14" value="ABORT — exit 1 (mustNotRoot)&#xa;never leaves root-owned files inside ~/.kiro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="790" y="130" width="330" height="58" as="geometry" />
        </mxCell>
        <mxCell id="15" value="ROLLBACK — install failed&#xa;&#xa;Any error inside the transaction calls tx.Rollback():&#xa;&#xa;• restore every touched path in reverse order (safeRoot.restore)&#xa;• delete the write-ahead backups created by this txid&#xa;• removeAll(backups/&lt;txid&gt;)&#xa;&#xa;The manifest is never sealed, so nothing is claimed as managed and the previous state survives — including a crash in the middle of the transaction, because each original was persisted to disk before being overwritten.&#xa;&#xa;exit 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="344" width="330" height="352" as="geometry" />
        </mxCell>
        <mxCell id="16" value="safeRoot — os.Root confinement&#xa;• every managed path is relative and cannot escape the root&#xa;• symlink refused in EVERY component, not just the final one&#xa;• atomicWrite: temp file + fsync + rename + parent dir fsync&#xa;• the existing file mode is preserved&#xa;• Windows: rename-over through a temporary old file" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="276" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="17" value="write-ahead, on every tx.Write&#xa;1. snapshot the current file (bytes + mode)&#xa;2. managed and hash differs ⇒ refuse unless --force&#xa;3. same path written twice in one transaction ⇒ refuse&#xa;4. persist the original to backups/&lt;txid&gt;/&lt;sha&gt;.bak (0600)&#xa;5. atomicWrite the new content&#xa;the original is on disk before the overwrite, so a crash&#xa;never loses it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="250" height="170" as="geometry" />
        </mxCell>
        <mxCell id="18" value="manifest.json — proof of ownership&#xa;settings/.kiro-secops/manifest.json (0600)&#xa;version · scope · toolVersion · updatedAt&#xa;entries[] sorted by path:&#xa;• path · installedSHA256 · mode&#xa;• previous: existed · backup · backupSHA256 · mode&#xa;decoded with DisallowUnknownFields; every path and&#xa;backup location re-validated on load" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="624" width="250" height="156" as="geometry" />
        </mxCell>
        <mxCell id="19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="20" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="14" y="0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="21" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="14">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-10" />
          </mxGeometry>
        </mxCell>
        <mxCell id="22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7" target="12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="25" value="no · any step failed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.918;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="15">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-10" />
          </mxGeometry>
        </mxCell>
        <mxCell id="26" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#82B366;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="13">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="14" y="0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="27" value="--dry-run prints every action and writes nothing: no backups, no manifest. --force replaces a managed artifact whose hash no longer matches the manifest, after backing up the current content. 'kiro-secops init' runs this same transaction with scope=workspace against .kiro/kiro-secops/manifest.json, adding one step: each hook command is rewritten to the guard's validated absolute path. 'kiro-secops uninstall' reverses the transaction — it refuses to touch anything without a manifest, checks both the installed hash and the backup hash before restoring, and refuses a modified artifact unless --force. 'kiro-secops verify --strict' compares every entry against the manifest and reports OK, MISSING, MODIFIED or ERROR, which is also the drift detector for fleet rollouts." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="794" width="1080" height="76" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
