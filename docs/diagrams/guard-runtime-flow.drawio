          </mxGeometry>
        </mxCell>
        <mxCell id="28" value="The deny-list is not a sandbox: it complements permissions.yaml, it does not replace it, and a determined agent can rephrase a command around it. Confirmations are never decided here — permissions.yaml resolves them natively, where deny &gt; ask &gt; allow and no matching rule means ask. Because guard is a native binary it behaves identically on macOS, Linux and Windows without depending on a shell being available. 'kiro-secops verify' replays 19 deterministic block/allow cases through guardEval as a self-test, and 'verify --project .' checks that the absolute path pinned inside each hook still resolves — a hook that cannot start exits 127, which Kiro treats as a silent non-blocking failure." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="804" width="1080" height="76" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
